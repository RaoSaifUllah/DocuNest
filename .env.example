# Copy to .env; never commit real values. No default administrator password.
ConnectionStrings__Write=Host=localhost;Port=5432;Database=docunest;Username=YOUR_USER;Password=CHANGE_ME;SSL Mode=VerifyFull;Search Path=docunest,public
# Optional read/migration overrides; otherwise use Write. No database roles created by DocuNest.
DOCUNEST_TEST_CONNECTION=Host=localhost;Port=5432;Database=docunest_tests;Username=YOUR_USER;Password=CHANGE_ME
DocuNest__Origin=https://localhost:8443
DocuNest__StorageRoot=../../.runtime/storage
DocuNest__JwtPrivateKeyPath=../../.runtime/secrets/jwt.pem
DocuNest__EncryptionKeyPath=../../.runtime/secrets/encryption.key
DocuNest__RegistrationMode=InviteOnly
DocuNest__NotificationMode=LocalOnly
DocuNest__ScannerHost=localhost
DocuNest__ScannerPort=3310
